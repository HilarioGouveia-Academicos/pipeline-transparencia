# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo .env esta no .gitignore e NAO deve ser enviado ao Git.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DATABASE=transparencia

# Fase 1: ZIP fornecido pelo curso (caminho relativo à raiz).
ZIP_DADOS=data/viagens_2025_6meses.zip
TAMANHO_BLOCO=50000
# Opcional quando o ZIP já existe. ID do arquivo ZIP, não da pasta Drive.
DRIVE_FILE_ID=1R6re1574aCeqNfwJXQ_T7BwHCEsPfgvc

# Opcional: conexão de leitura exclusiva da Gold (se omitida, usa POSTGRES_*).
# DASHBOARD_POSTGRES_HOST=host_do_banco_de_leitura
# DASHBOARD_POSTGRES_PORT=5432
# DASHBOARD_POSTGRES_USER=leitor_gold
# DASHBOARD_POSTGRES_PASSWORD=senha_do_leitor
# DASHBOARD_POSTGRES_DATABASE=transparencia
